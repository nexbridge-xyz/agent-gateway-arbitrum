# Secrets: never commit. Only .env.example is tracked.
.env
.env.*
!.env.example
# Other files that hold keys: direnv settings, key and certificate files, and keystores.
.envrc
*.pem
*.key
*.p12
*.pfx
keystore*/
*keystore*.json
UTC--*

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Foundry
apps/contracts/out/
apps/contracts/cache/
apps/contracts/coverage/
apps/contracts/lcov.info
# Local and simulated runs. Real testnet broadcasts are kept as a deployment record:
# run-latest.json is tracked, its timestamped copies and lock files are not.
apps/contracts/broadcast/*/31337/
apps/contracts/broadcast/**/dry-run/
apps/contracts/broadcast/**/run-[0-9]*.json
apps/contracts/broadcast/**/*.lock

# Gateway runtime data: ledger, evidence files, payee lists, demo state
apps/gateway/data/

# Local agent settings and skills
.claude/
.agents/

# Editors and OS
.DS_Store
.idea/
.vscode/
