# Copy to .env (git-ignored) or run `pnpm keys:generate`, which fills in fresh keys.
# TESTNET ONLY. Never put a key here that has held real funds.

# --- Network: Arbitrum Sepolia (chain id 421614) ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Etherscan API V2 key (etherscan.io). One key covers Arbiscan on Arbitrum Sepolia.
# Used only to verify contract source.
ETHERSCAN_API_KEY=

# --- Protocol addresses on Arbitrum Sepolia ---
# Circle test USDC
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# ERC-8004 Identity Registry
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# --- Roles (testnet-only keys) ---
# Deployer: deploys MandateVault. Needs a little Sepolia ETH.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Principal: owns the vault and its funds; creates and revokes mandates.
PRINCIPAL_PRIVATE_KEY=
PRINCIPAL_ADDRESS=
# Executor: the gateway's capped role. Can only pay inside a mandate.
EXECUTOR_PRIVATE_KEY=
EXECUTOR_ADDRESS=
# Approver: signs approvals for payments outside a mandate.
APPROVER_PRIVATE_KEY=
APPROVER_ADDRESS=
# Spend wallet: low-value wallet that pays per-call API charges.
SPEND_WALLET_PRIVATE_KEY=
SPEND_WALLET_ADDRESS=
# Merchant: demo API that receives per-call payments.
MERCHANT_PRIVATE_KEY=
MERCHANT_ADDRESS=
# Agent: signs payment requests only. Never holds a key that can move money.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=
# Demo vendors: two fictional payees. Their keys are kept only so test USDC can be recovered.
VENDOR_A_PRIVATE_KEY=
VENDOR_A_ADDRESS=
VENDOR_B_PRIVATE_KEY=
VENDOR_B_ADDRESS=

# --- Gateway ---
# Port on localhost, and where the gateway keeps its ledger, evidence files and payee lists.
# Left empty, that is apps/gateway/data, which git ignores. Git ignores no other folder for you: if you
# name one inside this repository, add it to .gitignore first.
GATEWAY_PORT=8787
GATEWAY_DATA_DIR=
# The most the gateway pays for one API call from its spend wallet, in USDC.
GATEWAY_PURCHASE_CALL_CAP=0.5

# --- Console ---
# The console reads its settings from the shell, not from this file. If you change GATEWAY_PORT above,
# start the console with the same value: GATEWAY_PORT=... pnpm console
# The same goes for your own vault: start the console with MANDATE_VAULT_ADDRESS set to its address.
# Without it the console is for the vault this repository records as deployed, and refuses to send or
# sign anything while the gateway serves another one.

# --- Demo merchant ---
# Port on localhost. The principal's vendor registry names this address, so run demo step 1 again
# after changing it.
MERCHANT_PORT=8788

# --- Demo agent ---
# With a key the demo agent is Claude; without one, the scripted agent runs the same tools.
# Calls to the Claude API cost money.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# --- Deployed contracts (filled in after deployment) ---
MANDATE_VAULT_ADDRESS=
