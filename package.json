{
  "name": "agent-gateway-arbitrum",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Gateway: mandates, approvals and evidence for AI agent payments, settled in stablecoins on Arbitrum.",
  "license": "MIT",
  "author": "NexBridge Inc.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint && eslint . && tsc --noEmit && prettier --check .",
    "format": "pnpm -r --if-present run format && prettier --write .",
    "keys:generate": "bash scripts/generate-keys.sh",
    "demo": "tsx scripts/demo.ts",
    "demo:record": "tsx scripts/record-run.ts",
    "gateway": "pnpm --filter @agent-gateway/gateway run start",
    "console": "pnpm --filter @agent-gateway/console run dev",
    "merchant": "pnpm --filter @agent-gateway/merchant run start",
    "verify-evidence": "tsx apps/gateway/src/cli/verify-evidence.ts",
    "contracts:test": "pnpm --filter @agent-gateway/contracts run test",
    "contracts:coverage": "pnpm --filter @agent-gateway/contracts run coverage",
    "contracts:deploy:sepolia": "pnpm --filter @agent-gateway/contracts run deploy:sepolia"
  },
  "devDependencies": {
    "@agent-gateway/agent": "workspace:*",
    "@agent-gateway/contracts": "workspace:*",
    "@agent-gateway/gateway": "workspace:*",
    "@agent-gateway/merchant": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  }
}
